{
  "name": "real-math",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "postbuild": "tsx scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "validate:content": "tsx scripts/validate-content.ts",
    "lint:content": "tsx scripts/lint-content.ts",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run validate:content && npm run lint:content && npm run test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "size-limit": [
    {
      "name": "initial JS (index + vendor chunks, gzip)",
      "path": [
        "dist/assets/index-*.js",
        "dist/assets/react-*.js",
        "dist/assets/i18n-*.js",
        "dist/assets/force-graph-*.js"
      ],
      "limit": "210 KB"
    },
    {
      "name": "detail panel chunk (KaTeX, gzip)",
      "path": "dist/assets/DetailPanel-*.js",
      "limit": "95 KB"
    }
  ],
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,css,html,yml,yaml}": [
      "prettier --write"
    ],
    "src/content/graph-content.json": [
      "tsx scripts/validate-content.ts",
      "tsx scripts/lint-content.ts"
    ]
  },
  "dependencies": {
    "@sentry/react": "^10.57.0",
    "d3-force": "^3.0.0",
    "i18next": "^25.1.3",
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.29.1",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.1.0",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.9.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/react-katex": "^3.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
